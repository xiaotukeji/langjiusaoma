location /index {
    if ($args !~ nocache=) {
        set $args "${args}&nocache=$msec";
        return 302 $scheme://$host$uri?$args;
    }
    if (!-e $request_filename){
        rewrite  ^(.*)$  /index.php?s=$1  last;
    }
}

location / {
    if (!-e $request_filename){
        rewrite  ^(.*)$  /index.php?s=$1  last;   break;
    }
}